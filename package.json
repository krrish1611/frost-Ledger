{
  "name": "frostledger-monorepo",
  "version": "1.0.0",
  "description": "Blockchain-Enabled IoT Cold Chain Storage & Tamper Detection System",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "worker",
    "contracts",
    "frontend",
    "simulator"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "npm run --workspaces --if-present lint",
    "test": "npm run --workspaces --if-present test",
    "ci": "node scripts/ci.js",
    "simulate:live": "node run-simulator.js --url ws://localhost:3001/mqtt --count 20",
    "simulate:mqtt": "npm run simulate:mqtt --workspace=@frostledger/simulator",
    "seed": "npm run seed --workspace=backend",
    "migrate": "npm run migrate --workspace=backend"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
