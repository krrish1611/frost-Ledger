# ESP32 Firmware Configuration Template (PlatformIO / NVS storage)
# Wi-Fi network SSID (2.4GHz)
WIFI_SSID=MyColdChainWiFi

# Wi-Fi network WPA2 pre-shared key
WIFI_PASSWORD=replace_with_wifi_password

# Managed MQTT broker endpoint (HiveMQ or EMQX TLS)
MQTT_BROKER=broker.hivemq.com

# Managed MQTT broker TLS port
MQTT_PORT=8883

# Device unique hardware identifier registered in database
DEVICE_ID=dev-esp32-001

# Ed25519 32-byte private key burned into secure storage / NVS
DEVICE_PRIVATE_KEY_HEX=9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60
