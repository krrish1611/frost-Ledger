# Root Monorepo Environment Variables Template
# Copy relevant entries to service-specific .env files or specify shared defaults here.

# Backend API port
PORT=3001

# Primary PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coldchain

# Dedicated AI Service role connection string
DATABASE_URL_AI=postgresql://ai_service_role:ai_service_password@localhost:5432/coldchain

# Redis URL for BullMQ
REDIS_URL=redis://localhost:6379

# Shared secret header for telemetry webhook
WEBHOOK_SECRET=replace_with_webhook_shared_secret_string

# JWT Secret
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters
