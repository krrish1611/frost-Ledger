{
  "name": "@frostledger/backend",
  "version": "1.0.0",
  "description": "Express REST API for FrostLedger Cold Chain Management",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.16",
    "@frostledger/shared": "file:../shared",
    "@frostledger/simulator": "file:../simulator",
    "@types/ws": "^8.18.2",
    "aedes": "^1.2.0",
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "ws": "^8.17.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.8",
    "@types/node": "22.13.1",
    "@types/pg": "8.11.11",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
