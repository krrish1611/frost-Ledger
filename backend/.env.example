# Backend Environment Variables
# Port number for Express HTTP server
PORT=3001

# Runtime environment (development, test, production)
NODE_ENV=development

# PostgreSQL connection string for official application role
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coldchain

# JSON Web Token signing secret key
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters

# JWT expiration string (e.g., 24h, 7d)
JWT_EXPIRES_IN=24h

# Shared secret header token required by POST /telemetry broker webhook
WEBHOOK_SECRET=replace_with_webhook_shared_secret_string

# Redis connection URL for BullMQ job queue
REDIS_URL=redis://localhost:6379

# Allowed CORS origin URL for the React dashboard
FRONTEND_URL=http://localhost:5173
