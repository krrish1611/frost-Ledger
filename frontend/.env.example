# Frontend Environment Variables
# Base URL of the backend API
VITE_API_URL=http://localhost:3001

# Dedicated Polygon Amoy RPC endpoint (Alchemy, Infura, QuickNode, or public fallback)
# Using a dedicated RPC avoids public rate limits for on-chain Merkle root verification.
VITE_POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
