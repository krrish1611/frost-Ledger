# Simulator Environment Variables
# Target backend API URL to submit batches
BACKEND_API_URL=http://localhost:3001

# Shared webhook secret token matching backend WEBHOOK_SECRET
WEBHOOK_SECRET=replace_with_webhook_shared_secret_string

# MQTT broker URL (TLS enabled)
MQTT_BROKER_URL=mqtts://broker.hivemq.com:8883

# MQTT authentication username
MQTT_USERNAME=device_simulator_user

# MQTT authentication password
MQTT_PASSWORD=device_simulator_password

# 32-byte Ed25519 private key in hex representation
DEVICE_PRIVATE_KEY_HEX=9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60

# Device identifier
DEVICE_ID=dev-esp32-001

# Shipment identifier under test
SHIPMENT_ID=shipment-test-001
