# AI Service Environment Variables
# Port for FastAPI application
AI_SERVICE_PORT=8000

# PostgreSQL connection string restricted to the dedicated ai_service_role
DATABASE_URL_AI=postgresql://ai_service_role:ai_service_password@localhost:5432/coldchain

# URL of the official backend API
BACKEND_API_URL=http://localhost:3001

# SMTP mail server hostname for sending advisory warning emails
SMTP_HOST=smtp.mailtrap.io

# SMTP server port
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=replace_with_smtp_username

# SMTP authentication password
SMTP_PASS=replace_with_smtp_password

# Sender email address for advisory notifications
SMTP_FROM=ai-advisory@coldchain.test

# Number of initial readings during warm-up phase (advisory alerts suppressed)
WARMUP_READINGS=30

# Maximum advisory emails permitted per hour per shipment
AI_EMAIL_MAX_PER_HOUR=3
